# Facebook Access Token
# Get it from: https://developers.facebook.com/tools/explorer/
FB_ACCESS_TOKEN=your_access_token_here

# The Facebook Post ID you want to check
# Format: {page-id}_{post-id} or just {post-id}
POST_ID=123456789_987654321

# The correct answer to check against (case-insensitive)
CORRECT_ANSWER=42
